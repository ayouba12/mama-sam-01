# ----------------- SUPABASE BACKEND CONFIGURATION -----------------
# Official Supabase Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Vite Frontend Environment Variables (Exposed to client bundle via import.meta.env)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backend Server Environment Variables (Express & Node.js services)
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_here

# Next.js Compatibility Aliases
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Store & Administrator Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_SECONDARY_EMAIL=staff@example.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
APP_URL=https://your-app-url.run.app
